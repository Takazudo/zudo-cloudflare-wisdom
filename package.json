{
  "name": "zudo-cloudflare-wisdom",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "run-p dev:zfb dev:history",
    "dev:zfb": "zfb dev",
    "dev:zfb:network": "zfb dev --host 0.0.0.0",
    "dev:network": "run-p dev:zfb:network dev:history",
    "dev:history": "doc-history-server --port 4322 --content-dir src/content/docs --locale ja:src/content/docs-ja",
    "build": "zfb build",
    "preview": "zfb preview",
    "check": "zfb check",
    "check:html": "pnpm dlx html-validate \"dist/**/*.html\"",
    "check:code-parity": "node scripts/check-code-parity.mjs",
    "test:code-parity": "node --test scripts/check-code-parity.test.mjs",
    "check:pin-parity": "node scripts/check-pin-parity.mjs",
    "check:wrangler-pin": "node scripts/check-wrangler-pin.mjs",
    "check:category-meta": "node scripts/check-category-meta.mjs",
    "check:links": "node scripts/check-links.js --strict-broken --allowlist=.check-links-allowlist",
    "check:template-drift": "bash scripts/check-template-drift.sh",
    "format:md": "pnpm dlx @takazudo/mdx-formatter --write \"src/content/**/*.{md,mdx}\"",
    "format:md:check": "pnpm dlx @takazudo/mdx-formatter --check \"src/content/**/*.{md,mdx}\"",
    "b4push": "bash scripts/run-b4push.sh",
    "setup:doc-skill": "bash scripts/setup-doc-skill.sh cloudflare-wisdom",
    "setup:doc-skill-silent": "bash scripts/setup-doc-skill.sh --silent cloudflare-wisdom",
    "setup:doc-skill:claude": "bash scripts/setup-doc-skill.sh --target claude cloudflare-wisdom",
    "setup:doc-skill:codex": "bash scripts/setup-doc-skill.sh --target codex cloudflare-wisdom",
    "setup:doc-skill:both": "bash scripts/setup-doc-skill.sh --target both cloudflare-wisdom"
  },
  "dependencies": {
    "@takazudo/zdtp": "0.4.11",
    "@takazudo/zfb": "2.7.1",
    "@takazudo/zfb-adapter-cloudflare": "2.7.1",
    "@takazudo/zfb-md-wasm": "2.7.1",
    "@takazudo/zfb-runtime": "2.7.1",
    "@takazudo/zudo-doc": "^5.6.0",
    "@takazudo/zudo-doc-history-server": "^5.6.0",
    "diff": "^8.0.3",
    "katex": "^0.16.38",
    "minisearch": "^7.2.0",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "lefthook": "^1.11.0",
    "npm-run-all2": "^7.0.2",
    "pagefind": "^1.4.0",
    "typescript": "^5.9.0",
    "wrangler": "4.85.0"
  }
}
